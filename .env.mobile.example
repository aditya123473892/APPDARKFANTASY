# Copy to .env.mobile. Public, non-secret values only.
# Physical phone: replace localhost with your PC's Wi-Fi IPv4 address.
# Android emulator: use 10.0.2.2. Phone and PC must share a reachable network.
EXPO_PUBLIC_API_URL=http://localhost:9000/api
# If port 9000 is blocked but Metro (8081) is reachable, use the PC's
# http://<Wi-Fi-IP>:8081/api and enable both development proxy flags.
EXPO_DEV_API_PROXY=false
EXPO_DEV_API_PORT=9000
# Use ::1 when the backend listens on IPv6 localhost.
EXPO_DEV_API_HOST=127.0.0.1
EXPO_PUBLIC_DEV_API_PROXY=false

# Only enable with a backend that enforces message TTL and atomic view-once access.
EXPO_PUBLIC_CHAT_EPHEMERAL_ENABLED=false
EXPO_PUBLIC_AUTH_MODE=open
EXPO_PUBLIC_AUTH_BACKGROUND_TIMEOUT_MINUTES=0
EXPO_PUBLIC_SSL_PINNING_ENABLED=false
# Comma-separated SHA-256 SPKI hashes: current key plus backup key. Public values only.
EXPO_PUBLIC_SSL_PINS=

# Optional public Sentry ingestion address. Empty disables crash reporting.
EXPO_PUBLIC_SENTRY_DSN=
# Source map upload uses SENTRY_ORG, SENTRY_PROJECT and SENTRY_AUTH_TOKEN in EAS/CI.
# Never put an auth token in EXPO_PUBLIC_* or app.config.js.
