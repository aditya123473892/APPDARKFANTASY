{
  "expo": {
    "name": "DARKFANTASY",
    "slug": "darkfantasy",
    "version": "1.0.0",
    "icon": "./assets/branding/icon.png",
    "orientation": "portrait",
    "scheme": "darkfantasy",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FBF3F6",
    "android": {
      "package": "com.aditya123473892.darkfantasy",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/adaptive-foreground.png",
        "monochromeImage": "./assets/branding/adaptive-monochrome.png",
        "backgroundColor": "#181322"
      },
      "softwareKeyboardLayoutMode": "resize",
      "allowBackup": false
    },
    "ios": {
      "bundleIdentifier": "com.aditya123473892.darkfantasy",
      "buildNumber": "1",
      "supportsTablet": true,
      "privacyManifests": { "NSPrivacyTracking": false }
    },
    "web": { "favicon": "./assets/branding/favicon.png" },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF3F6",
          "image": "./assets/branding/splash-light.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "dark": { "image": "./assets/branding/splash.png", "backgroundColor": "#181322" }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "136eb041-ed2c-4aef-9120-b8f0f344c0d3"
      }
    },
    "owner": "aditya-61818"
  }
}
