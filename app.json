{
  "expo": {
    "name": "DARKFANTASY",
    "slug": "darkfantasy",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "darkfantasy",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0E0912",
    "android": {
      "package": "com.aditya123473892.darkfantasy",
      "adaptiveIcon": {
        "backgroundColor": "#0E0912"
      },
      "softwareKeyboardLayoutMode": "resize",
      "allowBackup": false
    },
    "ios": {
      "bundleIdentifier": "com.aditya123473892.darkfantasy",
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-splash-screen", { "backgroundColor": "#0E0912" }]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
