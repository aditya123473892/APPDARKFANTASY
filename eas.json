{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_VARIANT": "development", "EXPO_PUBLIC_API_URL": "http://10.0.2.2:9000/api" }
    },
    "apk": {
      "autoIncrement": true,
      "distribution": "internal",
      "environment": "production",
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_API_URL": "https://dfbackend.onrender.com/api",
        "EXPO_PUBLIC_PHONE_AUTH_REQUIRED": "false",
        "EXPO_PUBLIC_DEV_API_PROXY": "false",
        "EXPO_DEV_API_PROXY": "false"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_API_URL": "https://dfbackend.onrender.com/api",
        "EXPO_PUBLIC_PHONE_AUTH_REQUIRED": "false",
        "EXPO_PUBLIC_DEV_API_PROXY": "false",
        "EXPO_DEV_API_PROXY": "false"
      },
      "android": { "buildType": "app-bundle" },
      "ios": { "simulator": false }
    }
  },
  "submit": {
    "production": { "android": { "track": "internal" } }
  }
}
