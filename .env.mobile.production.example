# Copy these PUBLIC settings into .env.mobile or the EAS production environment.
# Build a new app after changing the endpoint. No AWS/Twilio/AI keys belong here.
EXPO_PUBLIC_API_URL=https://dfbackend.onrender.com/api
EXPO_PUBLIC_DEV_API_PROXY=false
EXPO_DEV_API_PROXY=false
EXPO_PUBLIC_AUTH_MODE=open
EXPO_PUBLIC_PHONE_AUTH_REQUIRED=true
EXPO_PUBLIC_CHAT_EPHEMERAL_ENABLED=false
EXPO_PUBLIC_DEFAULT_PHONE_COUNTRY=IN
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_URL=
EXPO_PUBLIC_ACCOUNT_DELETION_URL=
# IOS_USES_NON_EXEMPT_ENCRYPTION=
# GOOGLE_SERVICES_JSON is an EAS file environment variable containing the Android Firebase configuration.
